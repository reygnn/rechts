<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a sheet of paper with a folded corner and a few
  lines of text. Drawn in the 108x108 adaptive viewport with the page kept
  inside the central safe zone. White page + teal text lines on the teal
  background (see @color/ic_launcher_background).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page body (white) with rounded corners and a chamfered top-right fold. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,32 Q37,28 41,28 L61,28 L71,38 L71,76 Q71,80 67,80 L41,80 Q37,80 37,76 Z" />

    <!-- Folded corner (muted teal, suggests the back of the dog-ear). -->
    <path
        android:fillColor="#80CBC4"
        android:pathData="M61,28 L71,38 L61,38 Z" />

    <!-- Text lines (brand teal on the white page). -->
    <path
        android:fillColor="#006A6A"
        android:pathData="M43,44 L65,44 L65,47 L43,47 Z" />
    <path
        android:fillColor="#006A6A"
        android:pathData="M43,52 L65,52 L65,55 L43,55 Z" />
    <path
        android:fillColor="#006A6A"
        android:pathData="M43,60 L65,60 L65,63 L43,63 Z" />
    <path
        android:fillColor="#006A6A"
        android:pathData="M43,68 L57,68 L57,71 L43,71 Z" />
</vector>
