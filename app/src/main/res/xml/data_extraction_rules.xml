<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ counterpart of allowBackup="false": rechts' data (saved logins
     in the WebView profile, favorites, browsing mode) never leaves the device —
     neither via cloud backup nor device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
